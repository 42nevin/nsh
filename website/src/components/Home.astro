---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Architecture from './Architecture.astro';
import DemoFrame from './DemoFrame.astro';
import { demoSource, highlight } from '../lib/demo.js';
import { SECTIONS, sectionHrefs } from '../lib/sections';
import { REPO_URL, type Lang } from '../lib/site';

export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh-CN';
const hrefs = await sectionHrefs(lang);

// The hero runs the `counter` demo; its source is the code sample below it.
// Until website/demos/counter.tsx exists, the repository's counter example
// stands in, so the page never shows invented code.
const DEMO = 'counter';
const source = demoSource(DEMO) ?? readFileSync(join(process.cwd(), '..', 'examples', 'counter', 'App.tsx'), 'utf8').trimEnd();
const sourceName = demoSource(DEMO) ? `demos/${DEMO}.tsx` : 'examples/counter/App.tsx';
const code = await highlight(source);
const install = 'nsh init my-app\nnsh run my-app/App.tsx';

const copy = zh
  ? {
      eyebrow: '开源 · MIT 或 Apache-2.0',
      title: '用 TSX 写原生应用，由真正的原生视图渲染。',
      lead: '组件用 TSX 编写，运行在 QuickJS 中；响应式图、渲染器与布局全部是 Rust 实现的原生运行时；每个元素都是 UIKit 或 Android 的原生视图。没有 WebView，不需要 Node.js，只有一个可执行文件。',
      start: '开始使用',
      components: '浏览组件',
      copyLabel: '复制命令',
      copied: '已复制',
      signals: ['iOS 15+ · Android · Mac Catalyst', '单个 Rust 可执行文件', '无需 Node.js'],
      live: '实时运行的示例',
      codeKicker: '一个文件',
      codeTitle: '这就是整个应用。',
      codeLead: '上面手机里运行的就是这份源码。应用代码是唯一的 JavaScript，其余部分都在原生层完成。',
      points: [
        ['signal()', '状态存放在原生响应式图中。值变化时，只有读取它的文本和属性会更新，不需要虚拟 DOM 比对。'],
        ['<view> · <text>', '宿主元素直接映射为 UIView 与 android.view.View，触摸、无障碍与键盘都由系统处理。'],
        ['style={{ … }}', 'React Native 的样式语义，由 Taffy 在引擎线程上完成 Flexbox 与 Grid 布局。'],
        ['nsh run', '启动开发服务器并打开应用；保存后热更新，只重新渲染被修改的组件，状态保持不变。'],
      ],
      featKicker: '能力',
      featTitle: '原生运行时，而不是桥接层。',
      featLead: '每一项都可以在仓库中验证：对应的 crate、元素或命令都列在下面。',
      archKicker: '架构',
      archTitle: '每一帧，一次提交，一次跨线程。',
      archLead: '一个 JS 回合产生的所有操作在原生队列中合并为一次 Core::commit，得到一个 MountBatch，并以一次主线程跳转应用到原生视图。主线程从不等待 JS。',
      archNotes: [
        ['主线程从不等待 JS', '需要立即回答的系统回调（文本能否修改、返回键能否返回）由预先挂载的属性在原生层回答，事件随后再通知 JS。'],
        ['批量跨越线程', '没有逐项的 FFI 调用：节点 id 稠密、按索引寻址，未变化的样式与布局帧不会发送。'],
        ['文本只排版一次', '引擎线程用 CoreText 或 StaticLayout 测量并排版，主线程只负责绘制结果。'],
      ],
      sectionsKicker: '文档',
      sectionsTitle: '从这里开始。',
      read: '阅读',
    }
  : {
      eyebrow: 'Open source · MIT or Apache-2.0',
      title: 'Native apps in TSX, rendered by real native views.',
      lead: 'Write components in TSX. nsh runs them in QuickJS on a runtime written in Rust — reactive graph, renderer and layout included — and draws every element with UIKit or Android views. No web view, no Node.js, one binary.',
      start: 'Get started',
      components: 'Browse components',
      copyLabel: 'Copy commands',
      copied: 'Copied',
      signals: ['iOS 15+ · Android · Mac Catalyst', 'One Rust binary', 'No Node.js'],
      live: 'Running live',
      codeKicker: 'One file',
      codeTitle: 'This is the whole app.',
      codeLead: 'The phone above runs this source. Your app’s code is the only JavaScript; everything it calls into is native.',
      points: [
        ['signal()', 'State lives in a native reactive graph. A change updates exactly the text and props that read it — no virtual DOM diff.'],
        ['<view> · <text>', 'Host elements map to UIView and android.view.View, so touch, accessibility and the keyboard are the system’s own.'],
        ['style={{ … }}', 'React Native style semantics, laid out with flexbox and grid by Taffy on the engine thread.'],
        ['nsh run', 'Starts a dev server and the app; every save hot-reloads only the edited components and keeps the rest of the state.'],
      ],
      featKicker: 'Capabilities',
      featTitle: 'A native runtime, not a bridge.',
      featLead: 'Each of these is something you can check in the repository: the crate, element or command is named on the card.',
      archKicker: 'Architecture',
      archTitle: 'One commit per frame, one hop across threads.',
      archLead: 'Everything one JS turn changes is queued natively, applied in a single Core::commit, and handed to the main thread as one MountBatch. The main thread never waits for JS.',
      archNotes: [
        ['The main thread never waits for JS', 'Callbacks the system needs answered on the spot — may this text change, may the back button pop — are answered natively from props mounted beforehand; JS hears about it afterwards.'],
        ['Threads are crossed in batches', 'No per-item FFI calls. Node ids are dense indexes, and unchanged styles and frames are never sent.'],
        ['Text is laid out once', 'CoreText or StaticLayout measures and lays out text on the engine thread; the main thread only draws the result.'],
      ],
      sectionsKicker: 'Documentation',
      sectionsTitle: 'Start here.',
      read: 'Read',
    };

const features = zh
  ? [
      { icon: 'cpu', title: 'QuickJS + 原生运行时', body: '只有应用代码是 JavaScript。响应式图、渲染器和你导入的每个模块都是 Rust，编译后的 JSX 直接调用它们。', chips: ['QuickJS', 'nsh:rt'] },
      { icon: 'signal', title: '信号（Signals）', body: 'signal、computed、effect：细粒度响应式，由原生调度；变化只重新渲染读取它的部分。', chips: ['signal()', 'computed()', 'effect()'] },
      { icon: 'layout', title: 'Flexbox 与 Grid', body: 'Taffy 在引擎线程上布局每个节点，采用 React Native 的样式语义，并支持 CSS Grid。', chips: ['Taffy', 'flex', 'grid'] },
      { icon: 'tailwind', title: '原生解析的 Tailwind', body: 'class="p-4 rounded-xl" 在 Rust 中解析为样式；构建时检查未知类名，主题写在 nsh.json。', chips: ['class', 'nsh.json'] },
      { icon: 'views', title: '真正的原生视图', body: '每个元素都是 UIView 或 android.view.View，地图、WebView、视频等原生组件可以直接嵌入，没有层级问题。', chips: ['UIKit', 'Android View'] },
      { icon: 'motion', title: 'UI 线程上的动画', body: 'timing、spring、decay 驱动在原生动画图中运行；JS 只负责启动，结束时收到通知。', chips: ['nsh/animated', 'spring'] },
      { icon: 'list', title: '虚拟化 List', body: '单元格复用、多列、吸顶分组、倒序聊天列表；滚动时由原生绑定单元格。', chips: ['<list>', 'sticky', 'inverted'] },
      { icon: 'terminal', title: '单一可执行文件', body: 'nsh 集成了打包器（Rolldown + Oxc）、类型声明、开发服务器与打包发布。没有 node_modules。', chips: ['nsh init', 'nsh run', 'nsh package'] },
      { icon: 'reload', title: '热模块替换', body: '保存文件后只重新渲染修改过的组件，应用其余部分保持状态；日志与错误输出到终端。', chips: ['nsh dev', 'HMR'] },
      { icon: 'shield', title: '签名更新包', body: '以 .nshpkg 发布更新：Ed25519 签名，发布密钥由离线根密钥认证，设备端检查吊销列表。', chips: ['nsh publish', 'nsh verify'] },
      { icon: 'embed', title: '嵌入现有应用', body: '在已有的 iOS 或 Android 应用中放入 AppView / NshView，可同时运行多个实例，并注册自己的原生组件。', chips: ['Swift', 'Java'] },
      { icon: 'rust', title: 'Rust 编写的组件', body: 'nsh/ui/mobile 的 Button、Card、Sheet 等组件用 Rust 编写，在核心中运行，iOS 与 Android 上外观一致。', chips: ['nsh/ui/mobile'] },
    ]
  : [
      { icon: 'cpu', title: 'QuickJS on a native runtime', body: 'Only your app’s code is JavaScript. The reactive graph, the renderer and every module you import are Rust; compiled JSX calls them directly.', chips: ['QuickJS', 'nsh:rt'] },
      { icon: 'signal', title: 'Signals', body: 'signal, computed and effect: fine-grained reactivity scheduled natively. A change re-renders only what reads it.', chips: ['signal()', 'computed()', 'effect()'] },
      { icon: 'layout', title: 'Flexbox and grid', body: 'Taffy lays out every node on the engine thread, with React Native’s style semantics plus CSS grid.', chips: ['Taffy', 'flex', 'grid'] },
      { icon: 'tailwind', title: 'Tailwind, resolved natively', body: 'class="p-4 rounded-xl" becomes styles in Rust; unknown classes are reported at build time, and themes live in nsh.json.', chips: ['class', 'nsh.json'] },
      { icon: 'views', title: 'Real native views', body: 'Every element is a UIView or android.view.View, so maps, web views and video embed with no layering tricks.', chips: ['UIKit', 'Android View'] },
      { icon: 'motion', title: 'Animations on the UI thread', body: 'Timing, spring and decay drivers run in a native animation graph. JS starts them and is told when they settle.', chips: ['nsh/animated', 'spring'] },
      { icon: 'list', title: 'Virtualized List', body: 'Recycled cells, columns, sticky section headers and inverted chat lists, with cells bound natively while you scroll.', chips: ['<list>', 'sticky', 'inverted'] },
      { icon: 'terminal', title: 'One binary toolchain', body: 'nsh bundles with Rolldown and Oxc, writes type declarations, serves dev builds and packages apps. No node_modules.', chips: ['nsh init', 'nsh run', 'nsh package'] },
      { icon: 'reload', title: 'Hot module replacement', body: 'Save a file and only the edited components render again; the rest of the app keeps its state. Logs stream to your terminal.', chips: ['nsh dev', 'HMR'] },
      { icon: 'shield', title: 'Signed packages', body: 'Ship updates as .nshpkg: Ed25519-signed, release keys certified by an offline root, revocation lists checked on device.', chips: ['nsh publish', 'nsh verify'] },
      { icon: 'embed', title: 'Embeddable', body: 'Put an AppView or NshView into an existing iOS or Android app — several instances, no global singletons — and register your own native components.', chips: ['Swift', 'Java'] },
      { icon: 'rust', title: 'Components written in Rust', body: 'Button, Card, Sheet and the rest of nsh/ui/mobile are Rust, run in the core and look the same on iOS and Android.', chips: ['nsh/ui/mobile'] },
    ];

const icons: Record<string, string> = {
  cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 9h6v6H9zM9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  signal: '<path d="M2 12h3l3-8 4 16 3-8h7"/>',
  layout: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 9v12"/>',
  tailwind: '<path d="M12 6c-2.7 0-4.3 1.3-5 4 1-1.3 2.2-1.8 3.5-1.5.8.2 1.3.7 1.9 1.3 1 1 2.1 2.2 4.6 2.2 2.7 0 4.3-1.3 5-4-1 1.3-2.2 1.8-3.5 1.5-.8-.2-1.3-.7-1.9-1.3C15.6 7.2 14.5 6 12 6ZM7 12c-2.7 0-4.3 1.3-5 4 1-1.3 2.2-1.8 3.5-1.5.8.2 1.3.7 1.9 1.3 1 1 2.1 2.2 4.6 2.2 2.7 0 4.3-1.3 5-4-1 1.3-2.2 1.8-3.5 1.5-.8-.2-1.3-.7-1.9-1.3C10.6 13.2 9.5 12 7 12Z"/>',
  views: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M9 7h6M9 11h6M9 15h3"/>',
  motion: '<path d="M4 20c4 0 6-16 16-16"/><circle cx="20" cy="4" r="1.5"/>',
  list: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  terminal: '<path d="m4 17 6-6-6-6M12 19h8"/>',
  reload: '<path d="M21 12a9 9 0 1 1-2.6-6.4L21 8"/><path d="M21 3v5h-5"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  embed: '<rect x="2" y="4" width="20" height="16" rx="2"/><rect x="12" y="10" width="7" height="7" rx="1"/>',
  rust: '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5M12 13v8"/>',
};
---

<main class="home" id="main">
  <section class="hero">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__inner">
      <div class="hero__copy">
        <a class="eyebrow" href={REPO_URL} target="_blank" rel="noopener noreferrer">
          <span class="eyebrow__dot" aria-hidden="true"></span>{copy.eyebrow}
        </a>
        <h1>{copy.title}</h1>
        <p class="hero__lead">{copy.lead}</p>
        <div class="hero__actions">
          <a href={hrefs.docs} class="btn btn--primary">
            {copy.start}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={hrefs.components} class="btn">{copy.components}</a>
        </div>
        <div class="install" data-copy-text={install}>
          <pre><code><span class="install__prompt" aria-hidden="true">$</span>nsh init my-app
<span class="install__prompt" aria-hidden="true">$</span>nsh run my-app/App.tsx</code></pre>
          <button type="button" class="install__copy" aria-label={copy.copyLabel} data-label={copy.copyLabel} data-copied-label={copy.copied}>
            <svg class="install__icon-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>
            <svg class="install__icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
          </button>
        </div>
        <ul class="hero__signals">
          {copy.signals.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div class="hero__device">
        <DemoFrame name={DEMO} lang={lang} variant="phone" eager />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band__inner code-band">
      <header class="section-head">
        <span class="section-kicker">{copy.codeKicker}</span>
        <h2>{copy.codeTitle}</h2>
        <p>{copy.codeLead}</p>
        <dl class="code-points">
          {copy.points.map(([term, text]) => (
            <div>
              <dt><code>{term}</code></dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </header>
      <div class="code-window">
        <div class="code-window__bar">
          <span class="code-window__lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="code-window__title">{sourceName}</span>
        </div>
        <div class="code-window__body" set:html={code} />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band__inner">
      <header class="section-head">
        <span class="section-kicker">{copy.featKicker}</span>
        <h2>{copy.featTitle}</h2>
        <p>{copy.featLead}</p>
      </header>
      <div class="features">
        {features.map((f) => (
          <article class="feature">
            <div class="feature__head">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
              <h3>{f.title}</h3>
            </div>
            <p>{f.body}</p>
            <ul class="feature__chips">{f.chips.map((c) => <li>{c}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--tinted">
    <div class="band__inner">
      <header class="section-head">
        <span class="section-kicker">{copy.archKicker}</span>
        <h2>{copy.archTitle}</h2>
        <p>{copy.archLead}</p>
      </header>
      <div class="arch-panel">
        <Architecture lang={lang} />
      </div>
      <div class="arch-notes">
        {copy.archNotes.map(([title, text]) => (
          <div>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="band__inner">
      <header class="section-head">
        <span class="section-kicker">{copy.sectionsKicker}</span>
        <h2>{copy.sectionsTitle}</h2>
      </header>
      <div class="sections">
        {SECTIONS.map((section, i) => (
          <a class="section-card" href={hrefs[section.id]}>
            <span class="section-card__index">0{i + 1}</span>
            <h3>{section.label[lang]}</h3>
            <p>{section.blurb[lang]}</p>
            <span class="section-card__more">
              {copy.read}
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</main>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('.install')) {
    const button = box.querySelector<HTMLButtonElement>('.install__copy');
    let timer: ReturnType<typeof setTimeout> | undefined;
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copyText ?? '');
        button.dataset.copied = '';
        button.setAttribute('aria-label', button.dataset.copiedLabel ?? '');
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', button.dataset.label ?? '');
        }, 1600);
      } catch {}
    });
  }
</script>

<style is:global>
  .home {
    --page: 1280px;
    --section-gap: clamp(3.5rem, 7vw, 6rem);
  }

  .home > section { position: relative; border-top: 1px solid var(--border); }
  .home > section:first-child { border-top: 0; }

  .band__inner {
    position: relative;
    width: min(100% - 3rem, var(--page));
    margin-inline: auto;
    padding-block: var(--section-gap);
  }
  .band--tinted { background: var(--sidebar); }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.6rem;
    padding: 0 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--background);
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-raise);
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }
  .btn:hover { background: var(--secondary); }
  .btn:active { transform: translateY(1px); }
  .btn--primary { border-color: var(--brand); background: var(--brand); color: var(--brand-contrast); }
  .btn--primary:hover { border-color: var(--brand-hover); background: var(--brand-hover); }

  .section-head { max-width: 44rem; margin-bottom: 2.75rem; }
  .section-head h2 { margin: 0.85rem 0 0; font-size: clamp(1.9rem, 3.4vw, 2.8rem); font-weight: 660; letter-spacing: -0.042em; line-height: 1.06; }
  .section-head > p { max-width: 38rem; margin: 1rem 0 0; color: var(--muted-foreground); font-size: 1rem; line-height: 1.7; }
  .section-kicker { color: var(--muted-foreground); font: 600 0.68rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  html[lang^="zh"] .section-kicker { letter-spacing: 0.06em; }

  /* Hero */
  .hero { overflow: hidden; }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(90% 80% at 75% 35%, black 10%, transparent 72%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    width: min(100% - 3rem, var(--page));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .hero__copy { max-width: 38rem; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.72rem;
    font-weight: 560;
    text-decoration: none;
    transition: border-color 150ms ease;
  }
  .eyebrow:hover { border-color: var(--brand-line); }
  .eyebrow__dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 20%, transparent); }

  .hero h1 { margin: 1.25rem 0 0; font-size: clamp(2.3rem, 4.6vw, 3.75rem); font-weight: 680; letter-spacing: -0.045em; line-height: 1.02; text-wrap: balance; }
  html[lang^="zh"] .hero h1 { letter-spacing: -0.02em; line-height: 1.15; }
  .hero__lead { margin: 1.25rem 0 0; color: var(--muted-foreground); font-size: 1.06rem; line-height: 1.7; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.75rem; }

  .install {
    position: relative;
    display: flex;
    align-items: flex-start;
    max-width: 24rem;
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--code-bg);
  }
