---
import Logo from './Logo.astro';
import { REPO_URL, url, type Lang } from '../lib/site';
import { SECTIONS, sectionHrefs } from '../lib/sections';

export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh-CN';
const hrefs = await sectionHrefs(lang);

const copy = isZh
  ? { tagline: '用 TSX 编写原生应用，由真正的原生视图渲染。', license: '以 MIT 或 Apache-2.0 许可发布，由', by: '开发。', nav: '页脚导航', issues: '报告问题', source: '源代码' }
  : { tagline: 'Native apps in TSX, rendered by real native views.', license: 'Licensed under MIT or Apache-2.0. Developed by', by: '.', nav: 'Footer', issues: 'Report an issue', source: 'Source code' };
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <a href={url(isZh ? 'zh-CN' : '')} class="site-footer__name"><Logo class="site-footer__logo" /> native-shell</a>
    <p>{copy.tagline}</p>
    <p>{copy.license} <a href="https://longbridge.com" target="_blank" rel="noopener noreferrer">Longbridge</a>{copy.by}</p>
  </div>
  <nav aria-label={copy.nav}>
    {SECTIONS.map((section) => <a href={hrefs[section.id]}>{section.label[lang]}</a>)}
    <a href={REPO_URL} target="_blank" rel="noopener noreferrer">{copy.source}</a>
    <a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">{copy.issues}</a>
    <a href={url('llms.txt')}>llms.txt</a>
  </nav>
</footer>
