---
import type { Lang } from '../lib/site';
export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh-CN';

// One label set, drawn twice: across on wide screens, down on phones.
const t = zh
  ? {
      title: 'nsh 从 TSX 到原生视图的数据流',
      engine: '引擎线程', main: '主线程',
      js: ['你的 TSX', 'QuickJS 运行编译后的 JSX'],
      ops: ['nsh-js', '渲染器 → Op 队列'],
      core: ['nsh-core', '影子树 · Taffy 布局 · 文本'],
      batch: ['MountBatch', '每次提交一批'],
      ios: 'UIKit · iOS', android: 'Android View', web: 'Web DOM · 文档播放器',
      events: '原生手势 → 引擎线程 → JS 事件处理',
    }
  : {
      title: 'How nsh turns TSX into native views',
      engine: 'Engine thread', main: 'Main thread',
      js: ['Your TSX', 'QuickJS runs compiled JSX'],
      ops: ['nsh-js', 'renderer → queued Ops'],
      core: ['nsh-core', 'shadow tree · Taffy · text'],
      batch: ['MountBatch', 'one per commit'],
      ios: 'UIKit · iOS', android: 'Android View', web: 'Web DOM · docs player',
      events: 'native gestures → engine thread → JS handlers',
    };
---

<figure class="arch" role="img" aria-label={t.title}>
  <svg class="arch__wide" viewBox="0 0 1200 330" aria-hidden="true">
    <defs>
      <marker id="arch-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" class="arch__head" />
      </marker>
    </defs>

    <!-- Thread lanes -->
    <rect class="arch__lane" x="8" y="20" width="782" height="214" rx="16" />
    <text class="arch__lane-label" x="28" y="46">{t.engine}</text>
    <rect class="arch__lane arch__lane--main" x="878" y="20" width="314" height="214" rx="16" />
    <text class="arch__lane-label" x="898" y="46">{t.main}</text>

    <!-- Stages -->
    <g transform="translate(28 70)">
      <rect class="arch__box arch__box--js" width="168" height="136" rx="10" />
      <text class="arch__title" x="18" y="40">{t.js[0]}</text>
      <text class="arch__detail" x="18" y="64">{t.js[1]}</text>
      <text class="arch__code" x="18" y="108">&lt;view&gt; signal()</text>
    </g>
    <g transform="translate(226 70)">
      <rect class="arch__box" width="168" height="136" rx="10" />
      <text class="arch__title" x="18" y="40">{t.ops[0]}</text>
      <text class="arch__detail" x="18" y="64">{t.ops[1]}</text>
      <text class="arch__code" x="18" y="108">Op::Create …</text>
    </g>
    <g transform="translate(424 70)">
      <rect class="arch__box" width="200" height="136" rx="10" />
      <text class="arch__title" x="18" y="40">{t.core[0]}</text>
      <text class="arch__detail" x="18" y="64">{t.core[1]}</text>
      <text class="arch__code" x="18" y="108">Core::commit()</text>
    </g>
    <g transform="translate(654 70)">
      <rect class="arch__box arch__box--batch" width="120" height="136" rx="10" />
      <text class="arch__title" x="16" y="40">{t.batch[0]}</text>
      <text class="arch__detail" x="16" y="64">{t.batch[1]}</text>
    </g>
    <g transform="translate(898 60)">
      <rect class="arch__box arch__box--target" width="274" height="44" rx="8" />
      <text class="arch__target" x="18" y="28">{t.ios}</text>
      <rect class="arch__box arch__box--target" y="56" width="274" height="44" rx="8" />
      <text class="arch__target" x="18" y="84">{t.android}</text>
      <rect class="arch__box arch__box--target arch__box--web" y="112" width="274" height="44" rx="8" />
      <text class="arch__target" x="18" y="140">{t.web}</text>
    </g>

    <!-- Flow -->
    <path class="arch__flow" d="M196 138h28" marker-end="url(#arch-head)" />
    <path class="arch__flow" d="M394 138h28" marker-end="url(#arch-head)" />
    <path class="arch__flow" d="M624 138h28" marker-end="url(#arch-head)" />
    <path class="arch__flow arch__flow--hop" d="M774 138h48c18 0 18-56 36-56h38" marker-end="url(#arch-head)" />
    <path class="arch__flow arch__flow--hop" d="M822 138h74" marker-end="url(#arch-head)" />
    <path class="arch__flow arch__flow--hop" d="M822 138c18 0 18 56 36 56h38" marker-end="url(#arch-head)" />

    <!-- Input -->
    <path class="arch__input" d="M1034 236v44H112v-72" marker-end="url(#arch-head)" />
    <text class="arch__input-label" x="573" y="306" text-anchor="middle">{t.events}</text>
  </svg>

  <svg class="arch__tall" viewBox="0 0 360 640" aria-hidden="true">
    <defs>
      <marker id="arch-head-tall" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" class="arch__head" />
      </marker>
    </defs>
    <rect class="arch__lane" x="4" y="4" width="352" height="414" rx="14" />
    <text class="arch__lane-label" x="20" y="28">{t.engine}</text>
    <rect class="arch__lane arch__lane--main" x="4" y="456" width="352" height="180" rx="14" />
    <text class="arch__lane-label" x="20" y="480">{t.main}</text>

    <g transform="translate(20 44)">
      <rect class="arch__box arch__box--js" width="320" height="64" rx="10" />
      <text class="arch__title" x="16" y="28">{t.js[0]}</text>
      <text class="arch__detail" x="16" y="49">{t.js[1]}</text>
    </g>
    <g transform="translate(20 136)">
      <rect class="arch__box" width="320" height="64" rx="10" />
      <text class="arch__title" x="16" y="28">{t.ops[0]}</text>
      <text class="arch__detail" x="16" y="49">{t.ops[1]}</text>
    </g>
    <g transform="translate(20 228)">
      <rect class="arch__box" width="320" height="64" rx="10" />
      <text class="arch__title" x="16" y="28">{t.core[0]}</text>
      <text class="arch__detail" x="16" y="49">{t.core[1]}</text>
    </g>
    <g transform="translate(20 320)">
      <rect class="arch__box arch__box--batch" width="320" height="64" rx="10" />
      <text class="arch__title" x="16" y="28">{t.batch[0]}</text>
      <text class="arch__detail" x="16" y="49">{t.batch[1]}</text>
    </g>
    <g transform="translate(20 496)">
      <rect class="arch__box arch__box--target" width="320" height="36" rx="8" />
      <text class="arch__target" x="16" y="23">{t.ios}</text>
      <rect class="arch__box arch__box--target" y="44" width="320" height="36" rx="8" />
      <text class="arch__target" x="16" y="67">{t.android}</text>
      <rect class="arch__box arch__box--target arch__box--web" y="88" width="320" height="36" rx="8" />
      <text class="arch__target" x="16" y="111">{t.web}</text>
    </g>
    <path class="arch__flow" d="M180 108v26" marker-end="url(#arch-head-tall)" />
    <path class="arch__flow" d="M180 200v26" marker-end="url(#arch-head-tall)" />
    <path class="arch__flow" d="M180 292v26" marker-end="url(#arch-head-tall)" />
    <path class="arch__flow arch__flow--hop" d="M180 384v110" marker-end="url(#arch-head-tall)" />
  </svg>
</figure>

<style>
  .arch { margin: 0; }
  .arch svg { display: block; width: 100%; height: auto; overflow: visible; }
  .arch__tall { display: none !important; max-width: 26rem; margin-inline: auto; }
  @media (max-width: 760px) {
    .arch__wide { display: none !important; }
    .arch__tall { display: block !important; }
  }

  .arch__lane { fill: color-mix(in srgb, var(--foreground) 2.5%, transparent); stroke: var(--border); stroke-dasharray: 4 4; }
  .arch__lane--main { fill: color-mix(in srgb, var(--data-2) 4%, transparent); stroke: color-mix(in srgb, var(--data-2) 35%, var(--border)); }
  .arch__lane-label { fill: var(--muted-foreground); font: 600 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

  .arch__box { fill: var(--background); stroke: var(--border); stroke-width: 1.2; }
  .arch__box--js { stroke: var(--border-hover); }
  .arch__box--batch { fill: color-mix(in srgb, var(--foreground) 4%, var(--background)); stroke: var(--brand-line); }
  .arch__box--target { stroke: color-mix(in srgb, var(--data-2) 45%, var(--border)); }
  .arch__box--web { stroke-dasharray: 4 3; }

  .arch__title { fill: var(--foreground); font: 640 15px var(--font-sans); letter-spacing: -0.01em; }
  .arch__detail { fill: var(--muted-foreground); font: 400 12.5px var(--font-sans); }
  .arch__code { fill: var(--code-type); font: 12px var(--font-mono); }
  .arch__target { fill: var(--foreground); font: 560 13.5px var(--font-sans); }

  .arch__flow { fill: none; stroke: var(--muted-foreground); stroke-width: 1.5; }
  .arch__flow--hop { stroke: var(--data-2); stroke-width: 1.8; }
  .arch__head { fill: var(--muted-foreground); }
  .arch__input { fill: none; stroke: var(--muted-foreground); stroke-width: 1.2; stroke-dasharray: 5 4; opacity: 0.8; }
  .arch__input-label { fill: var(--muted-foreground); font: 12px var(--font-mono); }
</style>
