---
import type { Lang } from '../lib/site';
export interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh-CN';
const names = isZh
  ? { system: '跟随系统', light: '浅色', dark: '深色', label: '外观' }
  : { system: 'System', light: 'Light', dark: 'Dark', label: 'Appearance' };
---

<!-- One button cycling System → Light → Dark. The icon shows the current
     preference (CSS reads `data-theme-pref` on <html>, set before paint). -->
<button
  class="theme-toggle site-nav__icon-btn"
  type="button"
  data-names={JSON.stringify(names)}
  aria-label={names.label}
  title={names.label}
>
  <svg class="theme-toggle__system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
  <svg class="theme-toggle__light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
  <svg class="theme-toggle__dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
</button>

<script>
  const ORDER = ['system', 'light', 'dark'] as const;
  type Pref = (typeof ORDER)[number];
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    const names = JSON.parse(button.dataset.names ?? '{}') as Record<Pref | 'label', string>;
    const sync = () => {
      const pref = (root.dataset.themePref ?? 'system') as Pref;
      const text = `${names.label}: ${names[pref]}`;
      button.setAttribute('aria-label', text);
      button.title = text;
    };
    sync();
    button.addEventListener('click', () => {
      const current = (root.dataset.themePref ?? 'system') as Pref;
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
      root.dataset.themePref = next;
      root.classList.toggle('dark', next === 'dark' || (next === 'system' && media.matches));
      try {
        if (next === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
  }
</script>
